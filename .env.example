# ==========================================================================
# NOCTRA — variables de entorno
# Copia este fichero a .env y rellena los valores.
# NUNCA subas el .env al repositorio ni expongas estas claves en el frontend.
# ==========================================================================

# --------------------------------- General --------------------------------
APP_NAME="Noctra"
# URL pública completa. En producción debe ser https://
APP_URL="http://localhost:3000"
NODE_ENV="development"
# Pon DEMO_MODE=false en producción para desactivar el checkout simulado.
DEMO_MODE=true

# ------------------------------- Base de datos ----------------------------
# PostgreSQL. Ejemplo: postgresql://usuario:clave@host:5432/noctra?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/noctra?schema=public"

# --------------------------------- Sesiones -------------------------------
# Secreto de 32+ caracteres. Genera uno con: openssl rand -base64 48
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
SESSION_TTL_DAYS=7
SESSION_REMEMBER_TTL_DAYS=30

# ---------------------------------- Stripe --------------------------------
# SOLO BACKEND. Estas claves jamás deben llegar al navegador.
STRIPE_SECRET_KEY="sk_live_o_sk_test_..."
# Secreto del endpoint de webhook (Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_..."
# IDs de precio recurrentes mensuales creados en Stripe
STRIPE_PRICE_BASIC="price_...."    # 9,99 EUR / mes
STRIPE_PRICE_PREMIUM="price_...."  # 19,99 EUR / mes

# ------------------------- Almacenamiento de vídeo ------------------------
# "blob"  → Vercel Blob privado (recomendado al desplegar en Vercel).
#           Crea el store en Vercel → Storage → Blob: la plataforma añade
#           BLOB_READ_WRITE_TOKEN automáticamente al proyecto.
# "s3"    → bucket PRIVADO propio (S3, Cloudflare R2, Backblaze B2…).
# "local" → solo desarrollo: guarda en ./storage, fuera de /public.
# Si no se define y existe BLOB_READ_WRITE_TOKEN, se usa "blob".
STORAGE_DRIVER="local"

# Lo inyecta Vercel al crear el store de Blob. No hace falta tocarlo a mano.
BLOB_READ_WRITE_TOKEN=""
S3_BUCKET=""
S3_REGION="auto"
# Endpoint personalizado para R2/B2/MinIO. Vacío para AWS S3.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Caducidad de las URLs firmadas de vídeo (segundos)
SIGNED_URL_TTL_SECONDS=900

# ------------------------- Correo transaccional ---------------------------
# Sin SMTP configurado los correos se registran por consola (modo demo).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Noctra <no-reply@tu-dominio.com>"

# ----------------------------- Seed (opcional) ----------------------------
SEED_ADMIN_EMAIL="admin@noctra.example"
SEED_ADMIN_PASSWORD="Noctra2026Admin"
# Ruta a un MP4 real para poder reproducir en la demo
SEED_VIDEO_PATH=""
